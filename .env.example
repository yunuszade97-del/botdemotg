# ============ Telegram ============
# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Куда слать лиды. Свой ID можно узнать у @userinfobot. Несколько — через запятую.
ADMIN_CHAT_IDS=123456789

# ============ Режим доставки апдейтов ============
# False — long polling (локальная разработка). True — вебхук (продакшен).
USE_WEBHOOK=False
# Обязателен при USE_WEBHOOK=True. Только https, без слэша на конце.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
# Проверяется в заголовке X-Telegram-Bot-Api-Secret-Token.
# Пусто — выведется детерминированно из BOT_TOKEN.
WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8080

# ============ LLM ============
LLM_API_KEY=sk-replace-me
# OpenAI:     https://api.openai.com/v1        + LLM_MODEL=gpt-4o-mini
# OpenRouter: https://openrouter.ai/api/v1     + LLM_MODEL=anthropic/claude-3.5-haiku
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=700
LLM_TIMEOUT=45
LLM_MAX_RETRIES=2
LLM_MAX_TOOL_ROUNDS=3

# ============ Хранилище ============
DB_PATH=data/bot.sqlite3

# ============ Контекст диалога ============
HISTORY_LIMIT=14
HISTORY_MAX_CHARS=12000
MAX_USER_MESSAGE_CHARS=2000

# ============ Анти-спам ============
THROTTLE_ENABLED=True
THROTTLE_MIN_INTERVAL=1.2
THROTTLE_MESSAGES_PER_MINUTE=15

# ============ Дедупликация лидов ============
# В течение скольких минут повторный вызов инструмента с тем же контактом
# считается дублем и не создаёт новую заявку. 0 — выключить.
LEAD_DEDUP_WINDOW_MINUTES=180

# ============ Профиль бизнеса (идёт в системный промпт) ============
COMPANY_NAME=Batumi Rent
COMPANY_BUSINESS=аренда автомобилей
COMPANY_CITY=Батуми
WORKING_HOURS=ежедневно 09:00–21:00
MANAGER_RESPONSE_TIME=5 минут
KNOWLEDGE_FILE=content/knowledge.md
# Пусто — используется шаблон по умолчанию.
WELCOME_MESSAGE=

# ============ Логи ============
LOG_LEVEL=INFO
