# ============ Telegram ============
# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Куда слать лиды. Свой ID можно узнать у @userinfobot. Несколько — через запятую.
ADMIN_CHAT_IDS=123456789

# ============ Режим доставки апдейтов ============
# False — long polling (локальная разработка). True — вебхук (продакшен).
USE_WEBHOOK=False
# Обязателен при USE_WEBHOOK=True. Только https, без слэша на конце.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
# Проверяется в заголовке X-Telegram-Bot-Api-Secret-Token.
# Пусто — выведется детерминированно из BOT_TOKEN.
WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8080

# ============ LLM ============
LLM_API_KEY=sk-replace-me
# OpenAI:     https://api.openai.com/v1        + LLM_MODEL=gpt-4o-mini
# OpenRouter: https://openrouter.ai/api/v1     + LLM_MODEL=anthropic/claude-3.5-haiku
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=700
LLM_TIMEOUT=45
LLM_MAX_RETRIES=2
LLM_MAX_TOOL_ROUNDS=3

# ============ Хранилище ============
DB_PATH=data/bot.sqlite3

# ============ Контекст диалога ============
HISTORY_LIMIT=14
HISTORY_MAX_CHARS=12000
MAX_USER_MESSAGE_CHARS=2000

# ============ Склейка подряд идущих сообщений ============
# Люди пишут очередями: «Иван», «+7 999...», «на август» — тремя сообщениями.
# Бот ждёт паузу и отправляет очередь в модель одним ходом: контакт из второго
# сообщения не теряется, а три сообщения стоят одного вызова LLM.
# 0 — выключить.
MESSAGE_AGGREGATION_DELAY=1.5

# ============ Анти-спам ============
THROTTLE_ENABLED=True
# 0 — сообщения склеиваются, а не отбрасываются. Ненулевое значение включает
# жёсткий отброс частых сообщений (и вместе с ним риск потерять контакт).
THROTTLE_MIN_INTERVAL=0
# Порог на реальный флуд. Стоимость сдерживают склейка и DAILY_LLM_CALLS_*.
THROTTLE_MESSAGES_PER_MINUTE=30

# ============ Суточные лимиты расходов на LLM ============
# Троттлинг ограничивает частоту, но не объём: 15 сообщений в минуту это
# 21 600 платных вызовов в сутки с одного аккаунта. 0 — лимит выключен.
DAILY_LLM_CALLS_PER_USER=60
DAILY_LLM_CALLS_GLOBAL=3000

# ============ Хранение персональных данных ============
# Через сколько дней удалять. 0 — хранить бессрочно (осознанное решение).
RETENTION_DAYS_MESSAGES=30
RETENTION_DAYS_LEADS=365
RETENTION_CLEANUP_HOURS=24

# ============ Доступ ============
# По умолчанию бот работает только в личных чатах. В группе он отвечал бы
# на каждое сообщение платным вызовом LLM.
ALLOW_GROUP_CHATS=False

# ============ Выгрузка лидов во внешнюю систему ============
# Пусто — выключено, лиды приходят только в Telegram.
# Сюда уходит POST с JSON на каждую новую заявку. Адрес приёмника:
# Make / Zapier / n8n / Google Apps Script / свой бэкенд — а уже оттуда
# в Google Sheets, amoCRM, Bitrix24 или что угодно ещё.
LEAD_WEBHOOK_URL=
# Если задан — уходит заголовок X-Lead-Signature: sha256=<hmac от тела>,
# чтобы приёмник мог отличить наши запросы от чужих.
LEAD_WEBHOOK_SECRET=
LEAD_WEBHOOK_TIMEOUT=10

# ============ Дедупликация лидов ============
# В течение скольких минут повторный вызов инструмента с тем же контактом
# считается дублем и не создаёт новую заявку. 0 — выключить.
LEAD_DEDUP_WINDOW_MINUTES=180

# ============ Профиль бизнеса (идёт в системный промпт) ============
# PROFILE подставляет разом: название, направление, город, часы работы,
# приветствие, файл базы знаний и набор вопросов для квалификации.
# Готовые ниши: rent_car, real_estate, tours  (`python -m app.profiles`).
# Своя ниша — см. docs/NICHES.md.
PROFILE=rent_car

# Точечные перекрытия профиля: один шаблон ниши — много клиентов.
# Пустая строка профиль НЕ перебивает, её можно оставить как есть.
# Если PROFILE пуст — заполните вручную, база знаний берётся из KNOWLEDGE_FILE.
COMPANY_NAME=
COMPANY_BUSINESS=
COMPANY_CITY=
WORKING_HOURS=
MANAGER_RESPONSE_TIME=
KNOWLEDGE_FILE=
# Пусто — приветствие берётся из профиля, иначе из шаблона по умолчанию.
WELCOME_MESSAGE=

# ============ Логи ============
LOG_LEVEL=INFO
